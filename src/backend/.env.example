# Salin file ini menjadi .env lalu isi sesuai lingkungan lokal Anda. Jangan commit .env.
PORT=7001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_anda
DB_NAME=rawat

# Dipakai express-session; isi string acak yang panjang
SESSION_SECRET=ganti_dengan_string_acak_panjang
